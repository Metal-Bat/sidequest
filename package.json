{
  "name": "sidequest-ui-tools",
  "private": true,
  "scripts": {
    "format": "prettier --write 'src/templates/**/*.html' 'src/static/*.html' 'src/static/*.css'",
    "format:check": "prettier --check 'src/templates/**/*.html' 'src/static/*.html' 'src/static/*.css'",
    "lint:html": "node scripts/lint-html.mjs",
    "lint:css": "stylelint 'src/static/*.css'",
    "lint": "npm run format:check && npm run lint:html && npm run lint:css",
    "fix": "npm run format && stylelint 'src/static/*.css' --fix && npm run format"
  },
  "devDependencies": {
    "htmlhint": "1.9.2",
    "prettier": "3.9.8",
    "prettier-plugin-go-template": "0.0.15",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0"
  }
}
